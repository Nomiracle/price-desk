# Price Desk — alert channel configuration
# Copy to /etc/price-alert.env (mode 600, owned by root) and reference it from
# the systemd unit with: EnvironmentFile=-/etc/price-alert.env
# Nothing here is required: without a channel the service logs alerts to the
# journal only and reports notifier=log.

# --- Telegram (optional) ---
#PRICE_ALERT_TELEGRAM_TOKEN=123456789:AAF...
#PRICE_ALERT_TELEGRAM_CHAT=123456789

# --- email (optional) ---
#PRICE_ALERT_EMAIL_TO=you@example.com
#PRICE_ALERT_EMAIL_FROM="Price Desk <onboarding@resend.dev>"
# transport A: any SMTP provider (QQ/Gmail/Outlook/Mailgun/SendGrid/Brevo/SES)
#PRICE_ALERT_SMTP_HOST=smtp.example.com
#PRICE_ALERT_SMTP_PORT=465
#PRICE_ALERT_SMTP_USER=you@example.com
#PRICE_ALERT_SMTP_PASS=<app-password>
#PRICE_ALERT_SMTP_TLS=implicit
# transport B: Resend HTTP API (needs only a key)
#PRICE_ALERT_RESEND_KEY=re_xxx

# --- detector tuning (bps) ---
#PRICE_ALERT_CEX_BPS=45
#PRICE_ALERT_DEX_BPS=150
#PRICE_ALERT_CEX_ABS_BPS=25
#PRICE_ALERT_DEX_ABS_BPS=60
#PRICE_ALERT_PEG_BPS=50
#PRICE_ALERT_CONFIRM=2
# a CEX book under this 24h quote turnover is judged by its mid, not by the
# last print, and can only ever emit watch (never mail an alert)
#PRICE_ALERT_THIN_CEX_VOLUME_USD=50000
#PRICE_ALERT_THIN_CEX_BPS=120
# mailbox gate: only alerts at or above this deviation are emailed
#PRICE_ALERT_EMAIL_MIN_BPS=100
# send every event, including watch level
#PRICE_ALERT_EMAIL_ALL=0
